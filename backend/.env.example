# Supabase — get from supabase.com > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Africa's Talking — get from account.africastalking.com
AT_USERNAME=sandbox
AT_API_KEY=your-africastalking-api-key
AT_SHORTCODE=your-shortcode

# M-Pesa Daraja — get from developer.safaricom.co.ke
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=your-business-shortcode
MPESA_PASSKEY=your-lipa-na-mpesa-passkey
MPESA_ENV=sandbox

# Meta WhatsApp Cloud API — get from developers.facebook.com
WHATSAPP_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=any-random-string-you-choose

PORT=3000
